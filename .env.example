# Option Chain Pulse — environment variables
# Copy this file to .env (already done for you) and .env.local (for broker keys)

# SQLite database location — relative path, works on Windows, macOS and Linux.
# Resolved relative to prisma/schema.prisma, so this points to <project-root>/db/custom.db
DATABASE_URL="file:../db/custom.db"

# ---------------------------------------------------------------------------
# Broker credentials (optional) — normally set via the in-app "API Keys"
# dialog, which writes these to .env.local for you. You only need to set
# these manually if you prefer editing files directly.
# ---------------------------------------------------------------------------
# BROKER_PROVIDER=icici|angel|dhan|fyers|zerodha|groww

# ICICI Direct Breeze
# ICICI_API_KEY=
# ICICI_SECRET_KEY=
# ICICI_SESSION_TOKEN=   # daily — get from https://api.icicidirect.com/apiuser/login?api_key=YOUR_API_KEY

# Angel One SmartAPI
# ANGEL_API_KEY=
# ANGEL_SECRET_KEY=
# ANGEL_CLIENT_CODE=
# ANGEL_PASSWORD=
# ANGEL_TOTP_SECRET=

# Dhan
# DHAN_ACCESS_TOKEN=
# DHAN_CLIENT_ID=

# Fyers
# FYERS_APP_ID=
# FYERS_SECRET_ID=
# FYERS_ACCESS_TOKEN=

# Zerodha Kite
# KITE_API_KEY=
# KITE_API_SECRET=
# KITE_ACCESS_TOKEN=

# Groww
# GROWW_ACCESS_TOKEN=
# GROWW_CLIENT_ID=
